<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="PlayerUI.uss"/>
    <!-- blocks-* classes come from the shared theme (Runtime/UI/Theme), not from a Style above, so
         they are available to any UIDocument in the project. The controls columns are built in C#
         from the Control Sections list on PlayerHUD, which is why they are empty here. -->
    <ui:VisualElement name="pause-menu" class="pause-menu blocks-overlay">
        <ui:VisualElement name="pause-menu-card" class="blocks-modal pause-menu__card">
            <ui:Label text="PAUSED" class="blocks-header blocks-header--space-bottom"/>
            <ui:VisualElement name="pause-menu-columns" picking-mode="Ignore" class="pause-menu__columns"/>
            <ui:VisualElement name="server-connection-section" class="server-connection">
                <ui:Label text="Server Connection" class="blocks-header blocks-header--sm server-connection__header"/>
                <ui:VisualElement class="server-connection__inputs">
                    <ui:VisualElement class="server-connection__field">
                        <ui:Label text="Ip Address" class="server-connection__label"/>
                        <ui:TextField name="ip-input" value="127.0.0.1" class="server-connection__text-field"/>
                    </ui:VisualElement>

                    <ui:VisualElement class="server-connection__field server-connection__field--port">
                        <ui:Label text="Port" class="server-connection__label"/>
                        <ui:TextField name="port-input" value="7777" class="server-connection__text-field"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="server-connection__actions">
                    <ui:Button name="connect-button" text="CONNECT" class="blocks-button blocks-button--sm server-connection__connect-button"/>
                </ui:VisualElement>

                <ui:Label name="connection-status" text="Status: Disconnected" class="server-connection__status server-connection__status--disconnected"/>
            </ui:VisualElement>
            <ui:VisualElement name="pause-menu-buttons" class="blocks-container--horizontal pause-menu__buttons">
                <ui:Button name="resume-button" text="RESUME" class="blocks-button blocks-element--space-right"/>
                <ui:Button name="quit-button" text="QUIT" class="blocks-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
