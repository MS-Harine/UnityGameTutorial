%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fcf7219bab7fe46a1ad266029b2fee19, type: 3}
  m_Name: Readme
  m_EditorClassIdentifier:
  icon: {fileID: 2800000, guid: a0d24a66aca844043a30ff1965111223, type: 3}
  title: Building Blocks 2D Platformer
  tagline: A playable platformer, and the parts it is made of.
  sections:
  - id: intro
    heading:
    stepNumber: 0
    isCompletable: 0
    isCollapsible: 0
    hasProgress: 1
    blocks:
    - kind: 0
      text: "Welcome! Follow the steps below to get started."
      tone: 0
      columns: []
      rows: []
      copyText:
      links: []
  - id: play
    heading: Play the game
    stepNumber: 1
    isCompletable: 1
    isCollapsible: 0
    hasProgress: 0
    blocks:
    - kind: 0
      text: "Press Play. Reach the wolf boss at the end of the level and defeat it to finish the game."
      tone: 0
      columns: []
      rows: []
      copyText:
      links:
      - text: Open SampleScene
        target: "guid:9665f4a2241d943fab1f3ca7abc1504d"
        sampleName:
        importedText:
        isPrimary: 1
  - id: contents
    heading: Look inside the characters
    stepNumber: 2
    isCompletable: 1
    isCollapsible: 0
    hasProgress: 0
    blocks:
    - kind: 0
      text: "Every character in the level is the same three parts: a [[BuildingBlocksCharacter|type:BuildingBlocksCharacter]] component, one movement ability, and one attack ability. Click any name below to find it in the Project window."
      tone: 0
      columns: []
      rows: []
      copyText:
      links: []
    - kind: 2
      text:
      tone: 0
      columns:
      - Character
      - Movement
      - Attack
      rows:
      - cells:
        - text: Player
          target: "guid:f0dde04f89ab0406298c602110e628e7"
          note:
        - text: PlayerMovementAbility
          target: "type:PlayerMovementAbility"
          note:
        - text: PlayerAttackAbility
          target: "type:PlayerAttackAbility"
          note:
      - cells:
        - text: MeleeEnemy
          target: "guid:1312ebbdc3a1344d1919794db1c0bcd6"
          note:
        - text: EnemyMovementAbility
          target: "type:EnemyMovementAbility"
          note:
        - text: EnemyMeleeAttackAbility
          target: "type:EnemyMeleeAttackAbility"
          note:
      - cells:
        - text: GrenadeEnemy
          target: "guid:4aa95472570404a59a73775c624ac498"
          note:
        - text: EnemyMovementAbility
          target: "type:EnemyMovementAbility"
          note:
        - text: ProjectileAttackAbility
          target: "type:ProjectileAttackAbility"
          note:
      - cells:
        - text: WolfBossEnemy
          target: "guid:e8b80709b8c60425ba68020801d66a5f"
          note:
        - text: EnemyMovementAbility
          target: "type:EnemyMovementAbility"
          note:
        - text: WolfBossAttackAbility
          target: "type:WolfBossAttackAbility"
          note:
      copyText:
      links: []
    - kind: 0
      text: "The enemies even share a movement ability: same script, different settings. See for yourself: press Play, select MeleeEnemy in the Hierarchy, and raise Chase Speed on its Enemy Movement Ability. The enemy speeds up instantly. Set Aggro Behavior to Stand and it stops chasing and holds its ground. Play Mode changes reset when you stop, so experiment freely."
      tone: 0
      columns: []
      rows: []
      copyText:
      links: []
    - kind: 0
      text: "Settings retune a character you already have. Swapping the parts makes a new one entirely, and that is step 3."
      tone: 0
      columns: []
      rows: []
      copyText:
      links:
      - text: Show character prefabs
        target: "path:Assets/[BuildingBlocks]/Prefabs"
        sampleName:
        importedText:
        isPrimary: 0
      - text: Show scripts
        target: "path:Assets/[BuildingBlocks]/Runtime"
        sampleName:
        importedText:
        isPrimary: 0
  - id: make-it-yours
    heading: Build your own character
    stepNumber: 3
    isCompletable: 1
    isCollapsible: 0
    hasProgress: 0
    blocks:
    - kind: 0
      text: "A character runs whatever abilities sit on it. That gives you three ways to build one:"
      tone: 0
      columns: []
      rows: []
      copyText:
      links: []
    - kind: 3
      text:
      tone: 0
      columns: []
      rows:
      - cells:
        - text: Copy a character
          target:
          note: "Duplicate a prefab from step 2 and retune its abilities in the Inspector. Fastest when a shipped character is close to what you want."
      - cells:
        - text: Mix and match
          target:
          note: "Add or remove ability components from the Movement and Attack cards on any character. No code involved. Try it: open the [[Player|guid:f0dde04f89ab0406298c602110e628e7]] prefab and add [[DashAbility|type:DashAbility]] from its Movement card. Then add a Dash action bound to Q in [[InputSystem_Actions|guid:2bcd2660ca9b64942af0de543d8d7100]], save the asset, and assign it to the ability's Dash Action field. Press Play and tap Q to dash."
      - cells:
        - text: Build one in the Creator
          target:
          note: "Five short steps and a playable character lands in your scene, wired to input so it responds the first time you press Play. Best when nothing shipped is close enough to copy."
      copyText:
      links:
      - text: Open Building Blocks Creator
        target: "menu:Building Blocks/Creator"
        sampleName:
        importedText:
        isPrimary: 1
    - kind: 0
      text: "Building characters is only half of what the Creator does. It can also write the first draft of a new ability, for when no shipped ability does what you want. Want a crouch? Pick Movement Ability on the Creator home, name it Crouch, and you get a short C# script with a marked YOUR LOGIC section where you write what crouching does. Attach it from any character's Movement card, then read [[DashAbility|type:DashAbility]] to see what a finished one looks like."
      tone: 0
      columns: []
      rows: []
      copyText:
      links: []
    - kind: 1
      text: "Every ability script is <b>yours</b> to edit, rename, or delete, the shipped ones included; nothing regenerates or overwrites them. The one component to leave alone while you are getting started is [[BuildingBlocksCharacter|type:BuildingBlocksCharacter]]: the player and every enemy run on it, so a change there changes them all."
      tone: 0
      columns: []
      rows: []
      copyText:
      links: []
  - id: agent
    heading: Optional samples
    stepNumber: 4
    isCompletable: 1
    isCollapsible: 0
    hasProgress: 0
    blocks:
    - kind: 0
      text: "This step shows how coding agents can plug into a project's own editor tools, in this case the Creator. Both samples fill its form in from a prompt and finish on the Review step, where you can change anything before it is created. Each one ships with the template but stays out of your project until you import it; importing copies it under Assets/Samples, and deleting that folder removes it again."
      tone: 0
      columns: []
      rows: []
      copyText:
      links: []
    - kind: 1
      text: "<b>Before your first prompt:</b> sign in to your Unity account, then open Project Settings > Services and link the project to an organization with credits. The buttons below open the settings page and the setup guide."
      tone: 0
      columns: []
      rows: []
      copyText:
      links:
      - text: Open Services settings
        target: "settings:Project/Services"
        sampleName:
        importedText:
        isPrimary: 0
      - text: Assistant documentation
        target: "url:https://docs.unity3d.com/Packages/com.unity.ai.assistant@latest"
        sampleName:
        importedText:
        isPrimary: 0
    - kind: 0
      text: "<b>AI Assisted Creator</b> is the in-editor example: a prompt tab in the Creator window. Describe a character or ability in plain words. It runs on Unity AI Assistant, which is not part of the template; importing the sample offers to install that package for you."
      tone: 0
      columns: []
      rows: []
      copyText:
      links:
      - text: Import sample
        target: "menu:Building Blocks/Creator (AI Assisted)"
        sampleName: AI Assisted Creator
        importedText: Open AI Assisted Creator
        isPrimary: 1
    - kind: 0
      text: "<b>Agent & CLI Workflow</b> is the from-the-terminal example, built for tools instead of people. It runs the same flow through the Unity CLI, a separate small install; setup is in the sample's README."
      tone: 0
      columns: []
      rows: []
      copyText:
      links:
      - text: Import sample
        target: "menu:Building Blocks/Creator (Agent & CLI)"
        sampleName: "Agent & CLI Workflow"
        importedText: "Open Agent & CLI Workflow"
        isPrimary: 1
      - text: Unity CLI docs
        target: "url:https://docs.unity.com/en-us/hub/unity-cli"
        sampleName:
        importedText:
        isPrimary: 0
  - id: reference
    heading: Reference
    stepNumber: 0
    isCompletable: 0
    isCollapsible: 1
    hasProgress: 0
    blocks:
    - kind: 3
      text: Building a character
      tone: 0
      columns: []
      rows:
      - cells:
        - text: Player or enemy
          target:
          note: "There is no player type or enemy type, only different abilities. Abilities that read input make a player; abilities that watch a target make an enemy. Choose by who should be driving."
      - cells:
        - text: Adding a key
          target:
          note: "New moves need their own action. Add one in [[InputSystem_Actions|guid:2bcd2660ca9b64942af0de543d8d7100]], then assign it to the ability's action field in the Inspector. Leave the Move action as it is; movement reads its directions from it."
      - cells:
        - text: Turning things off
          target:
          note: "Untick any ability component to pause just that move. The Movement, Attack, and Targeting switches on the character stop whole groups at once; the Switches list below says exactly what each one stops."
      - cells:
        - text: Picking a sprite
          target:
          note: "The sprite is only the look; movement and attacks come from abilities. Prototype with any placeholder and swap in real art later. The shipped art is in [[Art/Characters|guid:5364da531a6e647b0ad80c6b4b2b2d54]], one folder per character."
      copyText:
      links: []
    - kind: 3
      text: Switches on a character
      tone: 0
      columns: []
      rows:
      - cells:
        - text: Movement
          target:
          note: "Off holds the character still, with gravity off too. Its movement abilities stop being driven."
      - cells:
        - text: Attack
          target:
          note: "Off stops its attack abilities. Touch damage checks it too."
      - cells:
        - text: Targeting
          target:
          note: "Off stops it choosing a target, which is what enemy abilities act on."
      copyText:
      links: []
    - kind: 0
      text: "The Unity CLI is documented outside this project."
      tone: 0
      columns: []
      rows: []
      copyText:
      links:
      - text: Unity CLI documentation
        target: "url:https://docs.unity.com/en-us/hub/unity-cli"
        sampleName:
        importedText:
        isPrimary: 0
      - text: Announcing the Unity CLI
        target: "url:https://discussions.unity.com/t/announcing-the-unity-cli-a-new-way-to-connect-your-tools-and-agents/1731104"
        sampleName:
        importedText:
        isPrimary: 0
